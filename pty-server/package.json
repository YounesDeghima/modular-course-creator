{
  "name": "pty-server",
  "version": "2.0.0",
  "type": "module",
  "description": "Secure sandboxed code execution server — Podman containers over WebSocket",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build-image": "podman build -t localhost/code-runner:latest -f Containerfile .",
    "test-image": "podman run --rm localhost/code-runner:latest python3 -c \"print('image OK')\""
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
